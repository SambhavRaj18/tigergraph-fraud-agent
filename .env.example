# TigerGraph Savanna Cloud Configuration
TG_HOST=https://your-workspace.i.tgcloud.io
TG_USERNAME=tigergraph
TG_GRAPH=FraudInvestigation
TG_GRAPHNAME=FraudInvestigation
TG_SECRET=your_graph_secret_here
TG_TOKEN=your_jwt_token_here
TG_API_TOKEN=your_api_token_here

# LLM Provider Configuration
# Supported providers: deterministic | gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# API Credentials (Optional if LLM_PROVIDER=deterministic)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
